# Resend Email Service (https://resend.com)
# Required for contact form email notifications
RESEND_API_KEY=
RESEND_TO_EMAIL=
# Optional: Set to your verified domain email (defaults to onboarding@resend.dev)
RESEND_FROM_EMAIL=

# WhatsApp Floating Button
# Phone number in international format without + (e.g., 15551234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Site URL (used for metadata, canonical URLs, and Open Graph)
# Full URL with protocol, no trailing slash (e.g., https://jonkumarwebsolutions.com)
NEXT_PUBLIC_SITE_URL=
